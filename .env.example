# Universal Video Clipper - Environment Configuration

# Server Network Configuration
PORT=5000
HOST=0.0.0.0

# Set to 1 or true to run with Waitress / Production WSGI
PRODUCTION=1

# Security & Limits
SECRET_KEY=your-super-secret-key-here-change-in-production
MAX_CONTENT_LENGTH=4294967296

# Storage Paths (Optional: Defaults to system ~/Downloads)
# SYSTEM_DOWNLOADS_DIR=/custom/downloads/path
